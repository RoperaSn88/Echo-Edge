# Triangular prism for the energy wall (right isosceles triangle of one cell x height 1)
# After Unity import (X is mirrored), at rotation 0 the slope faces +X/+Z and the right-angle corner sits at (-0.5, -0.5)
o EnergySlopeWall
v 0.5000 -0.5000 -0.5000
v -0.5000 -0.5000 -0.5000
v 0.5000 -0.5000 0.5000
v 0.5000 0.5000 -0.5000
v -0.5000 0.5000 -0.5000
v 0.5000 0.5000 0.5000
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn -0.0000 -1.0000 0.0000
vn 0.0000 1.0000 -0.0000
vn 0.0000 0.0000 -1.0000
vn -0.7071 0.0000 0.7071
vn 1.0000 0.0000 0.0000
s off
f 3/1/1 2/2/1 1/3/1
f 4/1/2 5/2/2 6/3/2
f 1/1/3 2/2/3 5/3/3 4/4/3
f 2/1/4 3/2/4 6/3/4 5/4/4
f 3/1/5 1/2/5 4/3/5 6/4/5
